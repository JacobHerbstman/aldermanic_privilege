# #################################################
# ## Generic gitignore for a task-based workflow
# #################################################

# --- System & Editor Files ---
.DS_Store
.Rhistory
__pycache__/
node_modules/

# --- Log files ---
*.log
slurmlogs/
tasks/*/code/run.sbatch

# --- Raw & Intermediate Data ---
# Ignore raw data by default, except static files required for replication.
data_raw/*
!data_raw/replication_sources/
data_raw/replication_sources/*
!data_raw/replication_sources/README.md
!data_raw/construction_review/
data_raw/construction_review/*
!data_raw/construction_review/README.md
!data_raw/construction_review/SHA256SUMS
!data_raw/Wards_2014.geojson
!data_raw/Wards_2015.geojson
!data_raw/illinois-250919-free.sha256
!data_raw/illinois-250919-free/
data_raw/illinois-250919-free/*
!data_raw/illinois-250919-free/gis_osm_water_a_free_1.shp
!data_raw/illinois-250919-free/gis_osm_water_a_free_1.dbf
!data_raw/illinois-250919-free/gis_osm_water_a_free_1.shx
!data_raw/illinois-250919-free/gis_osm_water_a_free_1.prj
!data_raw/illinois-250919-free/gis_osm_water_a_free_1.cpg

# Ignore the contents of ALL input, output, and temp folders
# for every task. The trailing slash is important.
tasks/*/input/
tasks/*/output/
tasks/*/temp/

# --- User-specific files ---
# (Add any local configuration files here if needed)
AGENTS.md
CLAUDE.md
.claude/

# --- Secrets ---
# Ignore file containing API keys and other secrets
.Renviron


# Local remnants from the research-archive branch.
tasks/audits/*
!tasks/audits/construction_review_history/
!tasks/audits/commercial_construction_review/
tasks/audits/commercial_construction_review/input/
tasks/audits/commercial_construction_review/output/
tasks/audits/commercial_construction_review/temp/
!tasks/audits/commercial_construction_review/report/*.csv.log
!tasks/audits/density_common_sample/
tasks/audits/density_common_sample/input/
tasks/audits/density_common_sample/output/
tasks/audits/density_common_sample/temp/
!tasks/audits/density_common_sample/report/*.csv.log
!tasks/audits/density_window_comparison/
tasks/audits/density_window_comparison/input/
tasks/audits/density_window_comparison/output/
tasks/audits/density_window_comparison/temp/
!tasks/audits/density_window_comparison/report/*.csv.log
tasks/archive/
tasks/_deprecated/

# Frozen files required by the paper.
!tasks/permit_block_hand_adjudications/output/
tasks/permit_block_hand_adjudications/output/*
!tasks/permit_block_hand_adjudications/output/manual_permit_block_assignments.csv
!tasks/new_construction_analysis_data/output/
tasks/new_construction_analysis_data/output/*
!tasks/new_construction_analysis_data/output/new_construction_analysis_data.csv
!tasks/density_boundary_characteristics/output/
tasks/density_boundary_characteristics/output/*
!tasks/density_boundary_characteristics/output/density_boundary_characteristics.csv

# ================== ADDITIONS ==================

# Paper: ignore generated build artifacts, keep paper source tracked
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.fdb_latexmk
paper/*.fff
paper/*.fls
paper/*.out
paper/*.pdf
paper/*.synctex.gz
paper/*.ttt

tmp/

# Local-only verification scratch
tasks/create_event_study_permit_data/code/manual_permit_block_review.csv

# Ignore auto-generated R graphics in any code/ folder
Rplots.pdf
**/code/Rplots.pdf

# Historical ward maps used by construction discovery.
!/data_raw/Chicago_Wards_1998.geojson
!/data_raw/Wards_2024.geojson

# Compiled research logbook.
/logbook/*.pdf
/logbook/*.aux
/logbook/*.log
/logbook/*.out
/logbook/*.toc

# Standard data reports remain versioned.
!tasks/*/report/
!tasks/*/report/*.csv.log

# Versioned source archive is distributed separately from Git.
/replication/*.tar.gz
/replication/*.tmp
!data_raw/construction_review/construction_condominium_history_20260909.csv

# Final construction decisions and preserved zoning history are replication inputs.
!tasks/new_construction_cleaning/output/
!tasks/construction_zoning_history/output/
!tasks/construction_*/report/*.gpkg.log

!tasks/audits/construction_review_history/report/*.log

# Historical review code retains documents and decisions, not disposable caches.
tasks/audits/construction_review_history/**/input/
tasks/audits/construction_review_history/**/output/
tasks/audits/construction_review_history/**/temp/
!tasks/audits/construction_review_history/**/report/*.log
!tasks/audits/construction_review_history/report/**/*.log
!tasks/prepare_new_construction/report/*.gpkg.log

# Reusable sales audits.
!tasks/audits/sales_price_tail_audit/
tasks/audits/sales_price_tail_audit/input/
