# #################################################
# ## Generic gitignore for a task-based workflow
# #################################################

# --- System & Editor Files ---
.DS_Store
.Rhistory
__pycache__/
node_modules/

# --- Log files ---
*.log
slurmlogs/
tasks/*/code/run.sbatch

# --- Raw & Intermediate Data ---
# Ignore raw data by default, except static files required for replication.
data_raw/*
!data_raw/Wards_2014.geojson
!data_raw/Wards_2015.geojson
!data_raw/illinois-250919-free.sha256
!data_raw/illinois-250919-free/
data_raw/illinois-250919-free/*
!data_raw/illinois-250919-free/gis_osm_water_a_free_1.shp
!data_raw/illinois-250919-free/gis_osm_water_a_free_1.dbf
!data_raw/illinois-250919-free/gis_osm_water_a_free_1.shx
!data_raw/illinois-250919-free/gis_osm_water_a_free_1.prj
!data_raw/illinois-250919-free/gis_osm_water_a_free_1.cpg

# Ignore the contents of ALL input, output, and temp folders
# for every task. The trailing slash is important.
tasks/*/input/
tasks/*/output/
tasks/*/temp/

# --- User-specific files ---
# (Add any local configuration files here if needed)
AGENTS.md
CLAUDE.md
.claude/

# --- Secrets ---
# Ignore file containing API keys and other secrets
.Renviron


# Local remnants from the research-archive branch.
tasks/audits/
tasks/archive/
tasks/_deprecated/

# Frozen files required by the paper.
!tasks/permit_block_hand_adjudications/output/
tasks/permit_block_hand_adjudications/output/*
!tasks/permit_block_hand_adjudications/output/manual_permit_block_assignments.csv
!tasks/new_construction_analysis_data/output/
tasks/new_construction_analysis_data/output/*
!tasks/new_construction_analysis_data/output/new_construction_analysis_data.csv
!tasks/density_boundary_characteristics/output/
tasks/density_boundary_characteristics/output/*
!tasks/density_boundary_characteristics/output/density_boundary_characteristics.csv

# ================== ADDITIONS ==================

# Paper: ignore generated build artifacts, keep paper source tracked
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.fdb_latexmk
paper/*.fff
paper/*.fls
paper/*.out
paper/*.pdf
paper/*.synctex.gz
paper/*.ttt

tmp/

# Local-only verification scratch
tasks/create_event_study_permit_data/code/manual_permit_block_review.csv

# Ignore auto-generated R graphics in any code/ folder
Rplots.pdf
**/code/Rplots.pdf
